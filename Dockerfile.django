# The admin's Yivi widget comes from the SPA's npm dependency, at the version
# its lockfile pins; see YIVI_FRONTEND_DIST in yivi_portal/settings/base.py.
FROM node:22-alpine AS yivi-frontend
WORKDIR /spa
COPY portal_spa/package.json portal_spa/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM python:3.12-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev python3-dev cron \
    && rm -rf /var/lib/apt/lists/* \
    && pip install poetry \
    && poetry config virtualenvs.create false

# Copy the current directory contents into the container at /app
COPY . /app

COPY --from=yivi-frontend /spa/node_modules/@privacybydesign/yivi-frontend/dist/yivi.js /app/portal_spa/node_modules/@privacybydesign/yivi-frontend/dist/yivi.js

# Set the working directory in the container
WORKDIR /app

# Install project dependencies
RUN poetry install --with prod --no-interaction --no-ansi

ENV STATIC_ROOT=/app/static
ENV MEDIA_ROOT=/app/media

RUN mkdir -p $STATIC_ROOT $MEDIA_ROOT

ENV STATIC_URL=/static/
ENV MEDIA_URL=/media/

EXPOSE 8000

CMD ["/bin/sh", "/app/entrypoint.sh"]
